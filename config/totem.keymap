//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <16 7>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <16 8>;
        };

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <22 23>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <23 24>;
        };

        cut {
            bindings = <&kp LG(X)>;
            key-positions = <21 22>;
        };

        question_mark {
            bindings = <&kp QUESTION>;
            key-positions = <28 29>;
            layers = <0>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 7>;
            layers = <0>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <17 18>;
            layers = <0>;
        };

        tmux_prefix {
            bindings = <&kp LC(A)>;
            key-positions = <10 11>;
            layers = <0>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <27 17>;
        };

        single_quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <16 18>;
            layers = <0>;
        };

        f18 {
            bindings = <&kp F18>;
            key-positions = <27 28>;
            layers = <0>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
            layers = <0>;
            timeout-ms = <30>;
        };

        shift+p {
            bindings = <&kp LS(P)>;
            key-positions = <8 9>;
            layers = <0>;
            timeout-ms = <30>;
        };
    };

    behaviors {
        homerow_Rshift: homerow_Rshift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RSHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
        };

        homerow: homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };

        homerow_LCtrl: homerow_LCtrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LCTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <140>;
            flavor = "tap-preferred";
        };

        LT_LANG_FAST: LT_LANG_FAST {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_LANG_FAST";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <120>;
        };

        homerow_LShift: homerow_LShift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LSHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            flavor = "tap-preferred";
        };
    };

    macros {
        tmux_prefix_s: tmux_prefix_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(A) &kp S>;
            label = "TMUX_PREFIX_S";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
       &kp Q                   &kp W                &kp E                    &kp R                     &kp T                            &kp Y      &kp U                      &kp I       &kp O    &kp P
       &homerow_LCtrl LCTRL A  &homerow LEFT_ALT S  &homerow LEFT_COMMAND D  &homerow_LShift LSHIFT F  &kp G                            &kp H      &kp J                      &kp K       &kp L    &homerow_Rshift RSHFT SEMICOLON
&mo 5  &kp Z                   &kp X                &kp C                    &kp V                     &kp B                            &kp N      &kp M                      &kp COMMA   &kp DOT  &kp SLASH                        &kp SINGLE_QUOTE
                                                    &kp LGUI                 &lt 1 SPACE               &homerow LA(LC(LEFT_GUI)) TAB    &kp ENTER  &LT_LANG_FAST 2 BACKSLASH  &caps_word
            >;
        };

        nav_num {
            bindings = <
           &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(E)  &kp LG(NUMBER_8)  &kp LS(LG(T))    &none      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
           &kp LG(A)         &tmux_prefix_s    &kp D      &trans            &kp LA(LS(G))    &none      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp LG(LS(RIGHT))
&kp CARET  &trans            &trans            &trans     &trans            &trans           &kp PLUS   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none              &none
                                               &trans     &trans            &trans           &kp EQUAL  &kp NUMBER_0  &kp MINUS
            >;
        };

        sym_func {
            bindings = <
           &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6   &kp NUMBER_7          &kp NUMBER_8   &kp NUMBER_9           &kp NUMBER_0
           &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT     &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp ASTERISK   &kp RIGHT_PARENTHESIS  &kp RS(COLON)
&kp TILDE  &trans           &trans        &trans        &trans        &trans          &trans         &trans                &kp LESS_THAN  &kp GREATER_THAN       &none          &trans
                                          &trans        &trans        &trans          &none          &none                 &none
            >;
        };

        device {
            bindings = <
                &none         &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_PRV
                &kp K_MUTE    &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none           &none         &none         &none         &none         &none
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3      &bt BT_SEL 4    &bt BT_NXT    &none         &none         &none         &none       &bt BT_CLR
                                                    &none                 &none             &none           &none         &none         &none
            >;
        };

        layer_7 {
            bindings = <
        &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &trans  &trans    &trans  &trans  &trans          &mmv MOVE_UP    &mmv MOVE_RIGHT
        &trans            &trans            &trans            &trans  &trans    &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &trans
&trans  &trans            &trans            &trans            &trans  &trans    &trans  &trans  &mkp LCLK       &trans          &trans           &trans
                                            &trans            &trans  &trans    &trans  &trans  &trans
            >;
        };

        num_layer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &kp N7        &kp N8  &kp N9  &kp MINUS
        &trans  &trans  &trans  &trans  &trans    &trans  &kp N4        &kp N5  &kp N6  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp NUMBER_1  &kp N2  &kp N3  &trans     &trans
                        &trans  &trans  &trans    &trans  &kp N0        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
