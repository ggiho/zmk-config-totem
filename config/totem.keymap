//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <16 7>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <16 8>;
        };

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <22 23>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <23 24>;
        };

        cut {
            bindings = <&kp LG(X)>;
            key-positions = <21 22>;
        };

        question_mark {
            bindings = <&kp QUESTION>;
            key-positions = <28 29>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 7>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <17 18>;
        };

        tmux_prefix {
            bindings = <&kp LC(A)>;
            key-positions = <10 11>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <27 17>;
        };

        single_quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <16 18>;
        };

        f18 {
            bindings = <&kp F18>;
            key-positions = <27 28>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <20 10>;
        };
    };

    behaviors {
        homerow_Rshift: homerow_Rshift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RSHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
        };

        homerow: homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };

        homerow_LCtrl: homerow_LCtrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LCTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick-tap-ms = <140>;
            flavor = "tap-preferred";
        };

        LT_LANG_FAST: LT_LANG_FAST {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_LANG_FAST";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <120>;
        };

        homerow_LShift: homerow_LShift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LSHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
            &kp Q                   &kp W                &kp E                    &kp R                     &kp T                         &kp Y      &kp U                      &kp I        &kp O    &kp P
            &homerow_LCtrl LCTRL A  &homerow LEFT_ALT S  &homerow LEFT_COMMAND D  &homerow_LShift LSHIFT F  &kp G                         &kp H      &kp J                      &kp K        &kp L    &homerow_Rshift RSHFT SEMICOLON
&caps_word  &kp Z                   &kp X                &kp C                    &kp V                     &kp B                         &kp N      &kp M                      &kp COMMA    &kp DOT  &kp SLASH                        &kp SINGLE_QUOTE
                                                         &kp LGUI                 &lt 1 SPACE               &homerow_LShift LSHIFT TAB    &kp ENTER  &LT_LANG_FAST 2 BACKSLASH  &lt 3 CARET
            >;
        };

        nav_num {
            bindings = <
                &kp LA(BACKSPACE)   &kp BACKSPACE  &kp UP     &kp DELETE     &kp LA(DELETE)        &none      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none
                &kp LA(LEFT_ARROW)  &kp LEFT       &kp DOWN   &kp RIGHT      &kp LA(RIGHT)         &none      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none
&bt BT_CLR_ALL  &kp LG(UP_ARROW)    &kp LG(LEFT)   &kp ENTER  &kp LG(RIGHT)  &kp LG(DOWN_ARROW)    &none      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none
                                                   &trans     &trans         &trans                &kp EQUAL  &kp NUMBER_0  &kp PERCENT
            >;
        };

        sym_func {
            bindings = <
           &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7          &kp NUMBER_8   &kp NUMBER_9           &kp NUMBER_0
           &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT     &kp CARET     &kp LEFT_PARENTHESIS  &kp ASTERISK   &kp RIGHT_PARENTHESIS  &kp RS(COLON)
&kp TILDE  &trans           &trans        &trans        &trans        &trans          &trans        &kp AMPERSAND         &kp LESS_THAN  &kp GREATER_THAN       &none          &kp DOUBLE_QUOTES
                                          &trans        &trans        &trans          &none         &none                 &none
            >;
        };

        device {
            bindings = <
                &none         &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_PRV
                &kp K_MUTE    &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none           &none         &none         &none         &none         &none
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3      &bt BT_SEL 4    &bt BT_NXT    &none         &none         &none         &none       &bt BT_CLR
                                                    &none                 &none             &none           &none         &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
